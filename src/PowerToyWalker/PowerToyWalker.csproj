<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <AssemblyName>Community.PowerToys.Run.Plugin.Walker</AssemblyName>
    <RootNamespace>PowerToyWalker</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>hjosugi</Authors>
    <Description>Switch to open windows with app icons and MRU ranking</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Walker.Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <PackageReference Include="Community.PowerToys.Run.Plugin.Dependencies" Version="0.97.0" />
    <None Update="plugin.json;Images/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
