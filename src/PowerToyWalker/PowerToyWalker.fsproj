<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <Platforms>x64;ARM64</Platforms>
    <Platform Condition="'$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <AssemblyName>Community.PowerToys.Run.Plugin.Walker</AssemblyName>
    <RootNamespace>PowerToyWalker</RootNamespace>
    <Authors>hjosugi</Authors>
    <Description>Switch to open windows with app icons and MRU ranking</Description>
    <!-- Copies FSharp.Core.dll to the output, for the host's plugin load context to find. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Win32.fs" />
    <Compile Include="NativeWindows.fs" />
    <Compile Include="WindowIcons.fs" />
    <Compile Include="WindowTracker.fs" />
    <Compile Include="Main.fs" />
    <ProjectReference Include="../Walker.Core/Walker.Core.fsproj" />
    <PackageReference Include="Community.PowerToys.Run.Plugin.Dependencies" Version="0.97.0" />
    <None Include="plugin.json;Images/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
